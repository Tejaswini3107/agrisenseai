{
  "name": "agrisense-mobile",
  "version": "1.0.0",
  "description": "AgrisenseAI Mobile App - React Native",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "lint": "eslint index.js src --ext .js",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/AgriSenseMobile/main.jsbundle --assets-dest ios/AgriSenseMobile",
    "build:ios": "npm run bundle:ios && LANG=en_US.UTF-8 xcodebuild -workspace ios/AgriSenseMobile.xcworkspace -scheme AgriSenseMobile -configuration Debug -destination 'id=28232A8E-1C48-4DAE-86C3-648D4CF80863'",
    "run:ios": "npm run build:ios && xcrun simctl install booted ~/Library/Developer/Xcode/DerivedData/AgriSenseMobile-*/Build/Products/Debug-iphonesimulator/AgriSenseMobile.app && xcrun simctl launch booted com.agrisense.mobile"
  },
  "keywords": [
    "react-native",
    "agriculture",
    "agrisense"
  ],
  "author": "Tejaswini",
  "license": "MIT",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/bottom-tabs": "^6.5.12",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "axios": "^1.6.2",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-native": "0.73.11",
    "react-native-dotenv": "^3.4.11",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-onesignal": "^4.4.1",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^4.8.1",
    "react-native-screens": "^3.27.0",
    "react-native-svg": "^14.0.0",
    "react-native-toast-message": "^2.1.6",
    "react-native-vector-icons": "^10.3.0",
    "tailwindcss": "^3.3.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "12.3.6",
    "@react-native/metro-config": "^0.73.0",
    "@testing-library/react-native": "^12.4.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.2.0"
  }
}
